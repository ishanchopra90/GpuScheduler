      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 49 },
      "id": 24,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(kafka_topic_partition_current_offset{topic=\"gpu.workloads.claimable\"}) - sum(kafka_consumergroup_current_offset{consumergroup=\"gpu-scheduler-worker\", topic=\"gpu.workloads.claimable\"})",
          "legendFormat": "gpu-scheduler-worker",
          "refId": "A"
        }
      ],
      "title": "Worker claimable queue lag",
      "type": "timeseries"
    }
