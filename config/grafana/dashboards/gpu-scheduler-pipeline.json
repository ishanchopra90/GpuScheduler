    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Current number of submitter pods (KEDA scales on consumer lag). Matches kubectl get pods -n $namespace -l app.kubernetes.io/name=gpu-scheduler-submitter.",
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 42 },
      "id": 15,
