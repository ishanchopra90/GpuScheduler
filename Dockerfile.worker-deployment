# Build the worker-deployment binary (scale-focused: poll Scheduled, claim, run sim).
FROM golang:1.25 AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace
COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -a -o worker-deployment cmd/worker-deployment/main.go

FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=builder /workspace/worker-deployment .
USER 65532:65532
ENTRYPOINT ["/worker-deployment"]
